<script src="~/lib/jquery/dist/jquery.min.js"></script>

@model Paciente

<div class="container mt-5">
    <input hidden asp-for="ID" id="IdPaciente" />

    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-body">
                    <h2 class="card-title text-center">Datos Personales</h2>
                    @if (Model.Nombre != null)
                    {
                        <p class="card-text"><strong>Nombre:</strong> @Model.Nombre</p>
                        <p class="card-text"><strong>Apellidos:</strong> @Model.Apellidos</p>
                        <p class="card-text"><strong>Cédula:</strong> @Model.Cedula</p>
                    }
                </div>
            </div>
            <div class="text-center mt-4">
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary" style="width: 150px;">Volver</a>
            </div>
        </div>
    </div>
</div>