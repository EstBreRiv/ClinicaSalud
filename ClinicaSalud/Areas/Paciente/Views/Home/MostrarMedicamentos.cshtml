
<script src="~/lib/jquery/dist/jquery.min.js"></script>

@model Paciente

<div class="container">

    <input hidden asp-for="ID" id="IdPaciente" />

    <div class="row pt-4">

        <div class="col-6">

            <div class="col-6">


                <h2 class="text-primary">
                    @if (Model.Nombre != null)
                    {
                        <h2>Medicamentos de @Model.Nombre</h2>
                    }
                    
                </h2>

            </div>


            <table id="tblData" class="table table-bordered  align-top table-striped" style="width:100%">
                <thead>
                    <tr>
                        <th>Nombre</th>
                    </tr>
                </thead>
            </table>

        </div>

        <script src="~/js/MostrarMedicamentos.js"></script>
