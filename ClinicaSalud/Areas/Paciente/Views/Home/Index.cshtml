@{
    ViewData["Title"] = "Inicio";
}

@model Paciente

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"]</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.5.0/font/bootstrap-icons.min.css" rel="stylesheet">
</head>
<body>

    <div class="container mt-5">
        @if (Model.Nombre != null)
        {
            <h1 class="text-center mb-4">Bienvenido, @Model.Nombre</h1>
        }

        <div class="list-group">
            <a href="/Paciente/Home/MostrarDatosPersonales/@Model.ID" class="list-group-item list-group-item-action d-flex align-items-center">
                <i class="bi bi-person-circle me-3" style="font-size: 1.5rem; color: purple;"></i>
                <span>Datos personales</span>
            </a>
            <a href="/Paciente/Home/MostrarTratamientos/@Model.ID" class="list-group-item list-group-item-action d-flex align-items-center">
                <i class="bi bi-card-list me-3" style="font-size: 1.5rem; color: orange;"></i>
                <span>Tratamientos</span>
            </a>
            <a href="/Paciente/Home/MostrarPadecimientos/@Model.ID" class="list-group-item list-group-item-action d-flex align-items-center">
                <i class="bi bi-heart-pulse me-3" style="font-size: 1.5rem; color: red;"></i>
                <span>Padecimientos</span>
            </a>
            <a href="/Paciente/Home/MostrarMedicamentos/@Model.ID" class="list-group-item list-group-item-action d-flex align-items-center">
                <i class="bi bi-capsule me-3" style="font-size: 1.5rem; color: orange;"></i>
                <span>Medicamentos</span>
            </a>
            <a href="/Paciente/Home/MostrarResultadoExamen/@Model.ID" class="list-group-item list-group-item-action d-flex align-items-center">
                <i class="bi bi-file-earmark-medical me-3" style="font-size: 1.5rem; color: blue;"></i>
                <span>Examen Médico</span>
            </a>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
</body>
</html>