@using ClinicaSalud.Models.ViewModels
@model PacienteTratamientoVM
<partial name="_Notifications" />

<form method="post">

    <input hidden asp-for="Paciente.ID" />

    <div class="border-5">
        <div class="row pb-4">
            <h2 class="text-primary"> Padecimientos </h2>
        </div>
    </div>

    <div class="border-4">
        <div class="mb-3">
            <label asp-for="TratamientoList" class="p-0"></label>
            <select asp-for="TratamientoID" asp-items="@Model.TratamientoList" class="form-control" multiple="multiple">
                <option disabled selected> --- Selecciona Tratamiento --- </option>
            </select>
        </div>


        <button type="submit" class="btn btn-primary" style="width:150px">Guardar</button>
        <a asp-controller="Paciente" asp-action="Index" style="width:150px" class="btn btn-secondary">Volver</a>
    </div>
</form>

