
<script src="~/lib/jquery/dist/jquery.min.js"></script>
<partial name="_Notifications" />

@model Paciente

<div class="container">

    <input hidden asp-for="ID" id="IdPaciente" />

    <div class="row pt-4">

        <div class="col-6">


            <h2 class="text-primary">
                Tratamientos de @Model.Nombre
            </h2>
            <h3>
                Cedula: @Model.Cedula
            </h3>

        </div>

        <div class="col-6 text-end align-content-center">
            <a asp-controller="Paciente" asp-action="AgregarTratamiento" asp-route-ID="@Model.ID" class="btn btn-primary "> <i class="bi bi-plus-circle"></i> Agregar Tratamiento</a>
        </div>
    </div>

    <table id="tblData" class="table table-bordered table-striped" style="width:100%">
        <thead>
            <tr>
                <th>Nombre</th>
            </tr>
        </thead>
    </table>

</div>

<script src="~/js/TratamientosPaciente.js"></script>
