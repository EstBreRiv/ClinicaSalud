@page
@model RegisterConfirmationModel
@{
    ViewData["Title"] = "Confirmación de Registro";
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ClinicaSalud</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ClinicaSalud.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body>
    <div class="container mt-5">
        <div class="card text-center shadow-lg p-3 mb-5 bg-white rounded">
            <div class="card-body">
                <h1 class="card-title text-success mb-4"><i class="bi bi-check-circle-fill"></i> Usuario creado correctamente</h1>
                <p class="card-text">El nuevo usuario ha sido creado exitosamente.</p>
                @if (Model.DisplayConfirmAccountLink)
                {
                    <div class="alert alert-info mt-4">
                        <strong>Nota:</strong> Vuelva a la pestaña del register.
                    </div>
                }
                <a href="~/Identity/Account/Register" class="btn btn-primary mt-3"><i class="bi bi-arrow-left-circle"></i> Volver al register</a>
            </div>
        </div>
    </div>
</body>
</html>

