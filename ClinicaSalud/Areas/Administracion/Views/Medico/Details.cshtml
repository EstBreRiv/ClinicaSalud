@model Medico


<div class="container mt-4">
    <div class="card">
        <div class="card-header bg-primary text-white">
            <h2>@Model.Nombre @Model.Apellidos</h2>
        </div>
        <div class="card-body d-flex align-items-center">
            <div class="col-md-8">
                <h5><strong>Número de Colegiado:</strong> @Model.NumeroColegiado</h5>
                <p><strong>Especialidades:</strong></p>
            </div>
            <div class="col-md-4 text-right">
                @if (!string.IsNullOrEmpty(Model.FotografiaUrl))
                {
                    <img src="~/@Model.FotografiaUrl" class="img-fluid" alt="Fotografía del Médico" style="width: 100%; max-width: 300px; height: auto;" />
                }
            </div>
        </div>
        <div class="card-footer text-center">
            <a asp-area="Administracion" asp-controller="Medico" asp-action="Index" class="btn btn-primary">Volver a la lista</a>
        </div>
    </div>
</div>

<script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
