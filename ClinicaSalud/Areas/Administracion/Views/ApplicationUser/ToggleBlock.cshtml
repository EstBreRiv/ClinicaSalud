
@model ApplicationUser

<form method="post" enctype="multipart/form-data">

    <input hidden asp-for="@Model.Cedula">

    <div class="border p-3 mt-4">
        <div class="mb-3">

            <label asp-for="Nombre" class="p-0"></label>
            <input asp-for="Nombre" type="text" class="form-control"></input>
            <span asp-validation-for="Nombre" class="text-danger"></span>

        </div>

        <button type="submit" class="btn btn-primary" style="width:150px">Guardar</button>
        <a asp-controller="Administracion" asp-action="Index" style="width:150px" class="btn btn-secondary">Volver</a>

        <button type="submit" class="btn btn-primary" style="width:150px">Guardar</button>
        <a asp-controller="Administracion" asp-action="ToggleBlock" style="width:150px" class="btn btn-secondary">Bloquear/Desbloquear</a>

    </div>
</form>