
@model List<Especialidad>

@* agregar partial notifications
 *@

<div class="container">
    <div class="row pt-4">
        <div class="col-6">
          <h2 class="text-primary">
               Lista de Especialidades Medicas
            </h2>
        </div>
        <div class="text-end">
            <a asp-controller="Especialidad" asp-action="Create" class="btn btn-primary"> <i class="bi bi-plus-circle"></i> Agregar Especialidad</a>
        </div>
    </div>

    <table class="table table-bordered table-striped">
        <thead>
           
            <tr>
                
                <th> Especialidad</th>
            </tr>
        </thead>

        <tbody>
        
            @foreach (var obj in Model.OrderBy(x => x.Nombre))
            {
                <tr>
                    <td>@obj.Nombre</td>
                    <td>
                        <div class="btn-group w-75" role="group">
                      
                            <a asp-controller="Make" asp-action="Edit" asp-route-id="@obj.ID" class="btn btn-primary mx-2">
                                <i class="bi bi-pencil-square"></i> Edit
                            </a>

                            <a asp-controller="Make" asp-action="Delete" asp-route-id="@obj.ID" class="btn btn-danger mx-2">
                                <i class="bi bi-trash"></i> Delete
                            </a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>