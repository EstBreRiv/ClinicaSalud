<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ClinicaSalud</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/ClinicaSalud.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="//cdn.datatables.net/2.0.7/css/dataTables.dataTables.min.css"></link>
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-primary border-bottom box-shadow mb-3">
            <div class="container-fluid">
                <a class="navbar-brand" asp-area="Paciente" asp-controller="Home" asp-action="Index" style="font-size: 1.5rem; font-weight: bold;">ClinicaSalud</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">


                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-white" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Administracion
                            </a>

                            <ul class="dropdown-menu">
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="Administracion" asp-controller="Especialidad" asp-action="Index">Especialidad</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="Administracion" asp-controller="Medico" asp-action="Index">Medico</a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link text-dark" asp-area="Administracion" asp-controller="ApplicationUser" asp-action="Index">Administrar Usuarios</a>
                                </li>
                            </ul>

                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle text-white" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                Medicina
                            </a>
                            @if (User.IsInRole(ClinicaSalud.Utilities.ClinicaSaludRoles.Role_Admin))
                            {
                                <ul class="dropdown-menu">
                                    <li class="nav-item">
                                        <a class="nav-link text-dark" asp-area="Medicina" asp-controller="Medicamento" asp-action="Index">Medicamento</a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link text-dark" asp-area="Medicina" asp-controller="Tratamiento" asp-action="Index">Tratamiento</a>
                                    </li>

                                    <li class="nav-item">
                                        <a class="nav-link text-dark" asp-area="Medicina" asp-controller="Padecimiento" asp-action="Index">Padecimiento</a>
                                    </li>
                                    <li class="nav-item">
                                        <a class="nav-link text-dark" asp-area="Medicina" asp-controller="Paciente" asp-action="Index">Pacientes</a>
                                    </li>

                                </ul>
                            }

                        </li>
                        
                        <ul class="navbar-nav">
                            @if (User.IsInRole(ClinicaSalud.Utilities.ClinicaSaludRoles.Role_Admin))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-light" asp-area="Identity" asp-controller="Account" asp-action="Register">Agregar nuevo usuario</a>
                                </li>
                            }
                        </ul>
                        <ul class="navbar-nav">
                            @if (User.IsInRole(ClinicaSalud.Utilities.ClinicaSaludRoles.Role_Medico))
                            {
                                <li class="nav-item">
                                    <a class="nav-link text-light" asp-area="Identity" asp-controller="Account" asp-action="Register">Agregar nuevo paciente</a>
                                </li>
                            }
                        </ul>
                        
                       
                    </ul>

                    <partial name="_LoginPartial"></partial>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            Proyecto-IF4101: C21366-C22066-C27160
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script src="//cdn.datatables.net/2.0.7/js/dataTables.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>


    @await RenderSectionAsync("Scripts", required: false)


</body>
</html>
